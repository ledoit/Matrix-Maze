{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": null,
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "matrix-maze-kappa.vercel.app" }],
      "destination": "https://matrix-maze.menhir-holdings.com/:path*",
      "permanent": true
    }
  ]
}
